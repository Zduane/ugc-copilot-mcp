{
  "name": "@ugccopilot/mcp",
  "version": "0.1.4",
  "description": "Official MCP (Model Context Protocol) server for UGC Copilot. Generate UGC-style video ads end-to-end (script, persona, image, video, overlay) from Claude Desktop, Cursor, Cline, Zed, or any MCP-compatible agent. Wraps the public REST API with 12 tools across free + authenticated tiers.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ugc-copilot",
    "claude",
    "cursor",
    "cline",
    "video-generation",
    "ai",
    "ugc",
    "sora",
    "veo",
    "kling",
    "seedance",
    "agent"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ugc-copilot-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --exclude test/smoke.test.ts",
    "smoke": "UGC_RUN_SMOKE=1 vitest run test/smoke.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "fetch-openapi": "tsx scripts/fetch-openapi.ts",
    "gen-types": "tsx scripts/gen-types.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.6.0",
    "openapi-typescript": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "UGC Copilot",
  "license": "MIT",
  "homepage": "https://ugccopilot.ai/api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zduane/ugc-copilot-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Zduane/ugc-copilot-mcp/issues",
    "email": "support@ugccopilot.ai"
  },
  "publishConfig": {
    "access": "public"
  }
}
